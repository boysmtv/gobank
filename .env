# Application
APP_ENV=development
APP_PORT=8080
APP_GRPC_PORT=9090

# Database
DATABASE_DSN=postgres://gobank:gobank@localhost:5432/gobank?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=5m

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# NATS
NATS_URL=nats://localhost:4222

# JWT (CHANGE IN PRODUCTION - minimum 32 chars)
JWT_ACCESS_SECRET=local-dev-access-secret-32-chars!
JWT_REFRESH_SECRET=local-dev-refresh-secret-32chars!
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=168h

# Argon2
ARGON2_MEMORY=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=2
ARGON2_SALT_LENGTH=16
ARGON2_KEY_LENGTH=32

# Observability
JAEGER_ENDPOINT=http://localhost:14268/api/traces
SERVICE_NAME=gobank